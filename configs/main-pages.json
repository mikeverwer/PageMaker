{"rows": 9, "input_data": [{"priority -insert": "0", "SEO index -set": 0, "SEO follow -set": 0, "SEO description -text": "Template page - MainPage", "html filename -insert": "page", "md filename -insert": "content", "names -insert": "page, Page", "path -insert": "", "link labels": "", "links -insert": ""}, {"priority -insert": "0.8", "SEO index -set": 1, "SEO follow -set": 1, "SEO description -text": "# Mike Verwer\nThe personal website of Mike Verwer, M. Sc. Mathematics.\nThis is the homepage. explore the site to learn more about me.\n\n\n", "html filename -insert": "index", "md filename -insert": "greeting", "names -insert": "home, Mike Verwer", "path -insert": "", "link labels": "", "links -insert": ""}, {"priority -insert": "0.4", "SEO index -set": 0, "SEO follow -set": 0, "SEO description -text": "Information about YouTube videos made by Mike Verwer.\nContact me to request a video.\n\n\n", "html filename -insert": "youtube_home", "md filename -insert": "", "names -insert": "youtube, YouTube", "path -insert": "/youtube/", "link labels": "", "links -insert": ""}, {"priority -insert": "0.6", "SEO index -set": 1, "SEO follow -set": 0, "SEO description -text": "Explore my teaching history and the courses I teach.  You can also take a look at my teaching portfolio which contains my teaching philosophy and all of my credentials.\n\n\n\n", "html filename -insert": "teaching_home", "md filename -insert": "", "names -insert": "teaching, Teaching", "path -insert": "/teaching/", "link labels": "Teaching Portfolio", "links -insert": "/assets/docs/teaching_portfolio.pdf target=_blank"}, {"priority -insert": "0.6", "SEO index -set": 1, "SEO follow -set": 0, "SEO description -text": "Take a look at the apps Mike has written. I've made a few programs that I use in my classes to showcase various concepts.\n\n\n", "html filename -insert": "programs_home", "md filename -insert": "", "names -insert": "programs, Programs", "path -insert": "/programs/", "link labels": "Roll Dice, Playing with Primes", "links -insert": "/programs/roll_dice.html, /programs/playing_with_primes.html"}, {"priority -insert": "0.75", "SEO index -set": 1, "SEO follow -set": 0, "SEO description -text": "Mike Verwer graduated from McMaster University with a Masters degree in Mathematics in 2019 and ahs been teaching ever since.\n\n\n", "html filename -insert": "about", "md filename -insert": "", "names -insert": "about, Mike Verwer", "path -insert": "/assets/docs/", "link labels": "Bergman's Condition and Near-Unanimity Terms", "links -insert": "/assets/docs/masters_thesis.pdf"}, {"priority -insert": "0.6", "SEO index -set": 1, "SEO follow -set": 0, "SEO description -text": "This is an app I've written to demonstrate the Central Limit Theorem in statistics.  I use rolling dice as a an example and take the sum of the faces.\nIt is an interactive simulation that rolls `N` dice, `T` times and each roll is remembered and displayed.\n\n\n", "html filename -insert": "roll_dice", "md filename -insert": "", "names -insert": "roll dice, Roll Dice", "path -insert": "/programs/", "link labels": "The CLT", "links -insert": "/assets/docs/the-clt.html target=_blank"}, {"priority -insert": "0.6", "SEO index -set": 1, "SEO follow -set": 0, "SEO description -text": "This is an app I wrote to demonstrate the Seive of Eratosthenes.  It animates the algorithm, and the animation can be interacted with.\nIt also contains", "html filename -insert": "playing_with_primes", "md filename -insert": "", "names -insert": "primes, Primes", "path -insert": "/programs/", "link labels": "The Sieve, The Novelties", "links -insert": "/assets/docs/eratosthenes.html target=_blank, /assets/docs/the-novelties.html target=_blank"}, {"priority -insert": "0", "SEO index -set": 0, "SEO follow -set": 0, "SEO description -text": "404. Page not found.", "html filename -insert": "404", "md filename -insert": "", "names -insert": "null, 404", "path -insert": "", "link labels": "", "links -insert": ""}], "project_data":